    "connect-flash": "^0.1.1",
    "dotenv": "^18.0.8",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-ejs-layouts": "^2.5.1",
    "express-session": "^1.19.0",
    "node-cron": "^4.6.0",
    "pino": "^10.4.0",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.4"
  }

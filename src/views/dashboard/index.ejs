<!-- Dashboard Home -->
<div class="space-y-6 fade-in">

  <!-- Stats Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <!-- Aplikasi -->
    <div class="glass-card rounded-2xl p-5 hover:border-brand-500/20 transition-all group">
      <div class="flex items-center justify-between mb-3">
        <div class="w-10 h-10 rounded-xl bg-blue-500/10 flex items-center justify-center group-hover:scale-110 transition-transform">
          <svg class="w-5 h-5 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
        </div>
      </div>
      <p class="text-2xl font-bold text-white"><%= stats.appCount %></p>
      <p class="text-xs text-dark-400 mt-1">Aplikasi Terdaftar</p>
    </div>

    <!-- Commands -->
    <div class="glass-card rounded-2xl p-5 hover:border-brand-500/20 transition-all group">
      <div class="flex items-center justify-between mb-3">
        <div class="w-10 h-10 rounded-xl bg-purple-500/10 flex items-center justify-center group-hover:scale-110 transition-transform">
          <svg class="w-5 h-5 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
        </div>
      </div>
      <p class="text-2xl font-bold text-white"><%= stats.commandCount %></p>
      <p class="text-xs text-dark-400 mt-1">Perintah Bot</p>
    </div>

    <!-- Schedules -->
    <div class="glass-card rounded-2xl p-5 hover:border-brand-500/20 transition-all group">
      <div class="flex items-center justify-between mb-3">
        <div class="w-10 h-10 rounded-xl bg-amber-500/10 flex items-center justify-center group-hover:scale-110 transition-transform">
          <svg class="w-5 h-5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
      </div>
      <p class="text-2xl font-bold text-white"><%= stats.scheduleCount %></p>
      <p class="text-xs text-dark-400 mt-1">Jadwal Aktif</p>
    </div>

    <!-- Groups -->
    <div class="glass-card rounded-2xl p-5 hover:border-brand-500/20 transition-all group">
      <div class="flex items-center justify-between mb-3">
        <div class="w-10 h-10 rounded-xl bg-brand-500/10 flex items-center justify-center group-hover:scale-110 transition-transform">
          <svg class="w-5 h-5 text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        </div>
      </div>
      <p class="text-2xl font-bold text-white"><%= stats.groupCount %></p>
      <p class="text-xs text-dark-400 mt-1">Grup WhatsApp</p>
    </div>
  </div>

  <!-- WA Connection + QR -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
    <!-- QR Code Section -->
    <div class="glass-card rounded-2xl p-6" x-data="{
      status: '<%= waStatus %>',
      account: <%= JSON.stringify(waAccount || null) %>,
      qrImage: null,
      loading: false,
      loadingText: '',
      alertMsg: '',
      alertType: 'info',

      init() {
        const socket = io();
        socket.on('wa:status', (d) => {
          this.status = d.status;
          if (d.status === 'connected') {
            this.qrImage = null;
            this.loading = false;
          }
        });
        socket.on('wa:account', (d) => {
          this.account = d;
        });
        socket.on('wa:qr', (d) => {
          this.qrImage = d.qr;
          if (d.qr) {
            this.status = 'connecting';
            this.loading = false;
          }
        });
      },

      showAlert(msg, type = 'info') {
        this.alertMsg = msg;
        this.alertType = type;
        setTimeout(() => {
          if (this.alertMsg === msg) this.alertMsg = '';
        }, 6000);
      },

      async refreshQR() {
        if (this.loading) return;
        this.loading = true;
        this.loadingText = 'Memuat ulang QR...';
        try {
          const res = await fetch('/wa/refresh', {
            method: 'POST',
            headers: { 'Accept': 'application/json' }
          });
          const data = await res.json();
          if (data.success) {
            this.showAlert(data.message, 'info');
          } else {
            this.showAlert(data.message || 'Gagal memuat ulang QR', 'error');
            this.loading = false;
          }
        } catch (err) {
          this.showAlert('Koneksi ke server gagal', 'error');
          this.loading = false;
        }
      },

      async logoutWA() {
        if (this.loading) return;
        if (!confirm('Putuskan koneksi WhatsApp sekarang? Sesi akan dibersihkan dan QR Code baru akan langsung disiapkan.')) {
          return;
        }
        this.loading = true;
        this.loadingText = 'Memutuskan akun & menyiapkan QR baru...';
        this.account = null;
        this.qrImage = null;
        try {
          const res = await fetch('/wa/logout', {
            method: 'POST',
            headers: { 'Accept': 'application/json' }
          });
          const data = await res.json();
          if (data.success) {
            this.showAlert(data.message, 'success');
          } else {
            this.showAlert(data.message || 'Gagal logout WhatsApp', 'error');
            this.loading = false;
          }
        } catch (err) {
          this.showAlert('Koneksi ke server gagal', 'error');
          this.loading = false;
        }
      },

      async resetSession() {
        if (this.loading) return;
        if (!confirm('Reset sesi akan menghapus seluruh file login lokal dan memulai ulang koneksi WhatsApp dari awal. Lanjutkan?')) {
          return;
        }
        this.loading = true;
        this.loadingText = 'Mereset sesi & membuat QR baru...';
        this.account = null;
        this.qrImage = null;
        try {
          const res = await fetch('/wa/reset', {
            method: 'POST',
            headers: { 'Accept': 'application/json' }
          });
          const data = await res.json();
          if (data.success) {
            this.showAlert(data.message, 'success');
          } else {
            this.showAlert(data.message || 'Gagal reset sesi', 'error');
            this.loading = false;
          }
        } catch (err) {
          this.showAlert('Koneksi ke server gagal', 'error');
          this.loading = false;
        }
      }
    }">
      <!-- Header -->
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-sm font-semibold text-white flex items-center gap-2">
          <svg class="w-4 h-4 text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
          Koneksi WhatsApp
        </h3>
        <button
          @click="refreshQR()"
          :disabled="loading"
          title="Muat Ulang / Refresh QR"
          class="p-1.5 rounded-lg text-dark-400 hover:text-white hover:bg-dark-800 transition-colors disabled:opacity-50 flex items-center gap-1 text-xs">
          <svg class="w-4 h-4" :class="loading ? 'animate-spin text-brand-400' : ''" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          <span class="hidden sm:inline">Refresh</span>
        </button>
      </div>

      <!-- Alert Notification -->
      <div x-show="alertMsg" x-transition class="mb-4 p-3 rounded-xl text-xs flex items-center justify-between gap-2"
           :class="alertType === 'success' ? 'bg-emerald-500/10 text-emerald-300 border border-emerald-500/20' : alertType === 'error' ? 'bg-red-500/10 text-red-300 border border-red-500/20' : 'bg-blue-500/10 text-blue-300 border border-blue-500/20'">
        <div class="flex items-center gap-2">
          <svg x-show="alertType === 'success'" class="w-4 h-4 text-emerald-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <svg x-show="alertType === 'error'" class="w-4 h-4 text-red-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          <svg x-show="alertType === 'info'" class="w-4 h-4 text-blue-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span x-text="alertMsg"></span>
        </div>
        <button @click="alertMsg = ''" class="text-dark-400 hover:text-white">&times;</button>
      </div>

      <!-- Status Badge -->
      <div class="flex items-center justify-between gap-2 mb-4 px-3 py-2 rounded-xl border"
           :class="status === 'connected' ? 'bg-emerald-500/10 text-emerald-300 border-emerald-500/20' : status === 'connecting' ? 'bg-yellow-500/10 text-yellow-300 border-yellow-500/20' : 'bg-red-500/10 text-red-300 border-red-500/20'">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full pulse-dot"
                :class="status === 'connected' ? 'bg-emerald-400' : status === 'connecting' ? 'bg-yellow-400' : 'bg-red-400'"></span>
          <span class="text-sm font-medium"
                x-text="status === 'connected' ? '✅ Terhubung' : status === 'connecting' ? '📱 Scan QR Code' : '❌ Terputus'"></span>
        </div>
        <span x-show="loading" class="text-xs text-brand-400 animate-pulse font-medium">Proses...</span>
      </div>

      <!-- Connected State -->
      <div x-show="status === 'connected'" class="text-center py-4">
        <div class="w-16 h-16 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center mx-auto mb-3">
          <svg class="w-8 h-8 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        </div>
        <div class="mb-4">
          <template x-if="account && account.phone">
            <div>
              <p class="text-base font-semibold text-white tracking-wide" x-text="'+' + account.phone"></p>
              <p class="text-xs text-dark-400 mt-0.5" x-text="account.name ? account.name : 'WhatsApp Bot Aktif'"></p>
            </div>
          </template>
          <template x-if="!account || !account.phone">
            <div>
              <p class="text-sm font-medium text-white">WhatsApp Siap Digunakan</p>
              <p class="text-xs text-dark-400 mt-0.5">Bot & Gateway aktif melayani pesan</p>
            </div>
          </template>
        </div>

        <div class="space-y-2 pt-2 border-t border-white/5">
          <button
            @click="logoutWA()"
            :disabled="loading"
            class="w-full flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/20 font-medium text-xs transition-all disabled:opacity-50">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
            Putuskan & Ganti Akun WhatsApp
          </button>
        </div>
      </div>

      <!-- Connecting with QR Code -->
      <div x-show="qrImage && status === 'connecting'" x-transition class="text-center py-2">
        <div class="inline-block p-3 bg-white rounded-2xl shadow-xl shadow-brand-500/10 border border-white/20">
          <img :src="qrImage" alt="QR Code WhatsApp" class="w-56 h-56 mx-auto">
        </div>
        <p class="text-xs text-dark-300 mt-3 font-medium">Buka WhatsApp → Perangkat Tertaut → Tautkan Perangkat</p>
        <p class="text-[11px] text-dark-500 mt-1">QR otomatis berganti. Klik tombol di bawah jika perlu muat ulang.</p>

        <!-- QR Actions -->
        <div class="grid grid-cols-2 gap-2 mt-4 pt-3 border-t border-white/5">
          <button
            @click="refreshQR()"
            :disabled="loading"
            class="flex items-center justify-center gap-1.5 px-3 py-2 rounded-xl bg-brand-500/10 hover:bg-brand-500/20 text-brand-400 border border-brand-500/20 font-medium text-xs transition-all disabled:opacity-50">
            <svg class="w-3.5 h-3.5" :class="loading ? 'animate-spin' : ''" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
            Muat Ulang QR
          </button>
          <button
            @click="resetSession()"
            :disabled="loading"
            class="flex items-center justify-center gap-1.5 px-3 py-2 rounded-xl bg-dark-800 hover:bg-dark-700 text-dark-300 hover:text-white border border-white/5 font-medium text-xs transition-all disabled:opacity-50">
            <svg class="w-3.5 h-3.5 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
            Reset Sesi
          </button>
        </div>
      </div>

      <!-- Disconnected or Connecting without QR -->
      <div x-show="(!qrImage && status === 'connecting') || (status === 'disconnected')" class="text-center py-6">
        <template x-if="loading">
          <div class="py-2">
            <div class="w-14 h-14 rounded-2xl bg-brand-500/10 border border-brand-500/20 flex items-center justify-center mx-auto mb-3">
              <svg class="w-7 h-7 text-brand-400 animate-spin" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
              </svg>
            </div>
            <p class="text-sm font-medium text-white" x-text="loadingText || 'Menyiapkan QR Code...'"></p>
            <p class="text-xs text-dark-400 mt-1">Menghubungi server WhatsApp, mohon tunggu sebentar...</p>
          </div>
        </template>

        <template x-if="!loading">
          <div>
            <div class="w-14 h-14 rounded-2xl bg-dark-800 border border-white/5 flex items-center justify-center mx-auto mb-3">
              <svg class="w-7 h-7 text-dark-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636a9 9 0 010 12.728M5.636 5.636a9 9 0 000 12.728"/></svg>
            </div>
            <p class="text-sm font-medium text-white">Koneksi WhatsApp Terputus</p>
            <p class="text-xs text-dark-400 mt-1 max-w-xs mx-auto">Sesi belum aktif atau baru saja logout. Klik tombol di bawah untuk menampilkan QR Code baru.</p>

            <div class="space-y-2 mt-5">
              <button
                @click="refreshQR()"
                :disabled="loading"
                class="w-full flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-brand-500 hover:bg-brand-600 text-white font-medium text-xs shadow-lg shadow-brand-500/20 transition-all disabled:opacity-50">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                Hubungkan WhatsApp / Tampilkan QR
              </button>
              <button
                @click="resetSession()"
                :disabled="loading"
                class="w-full flex items-center justify-center gap-2 px-3 py-2 rounded-xl bg-dark-800 hover:bg-dark-700 text-dark-400 hover:text-dark-200 border border-white/5 font-medium text-xs transition-all disabled:opacity-50">
                <svg class="w-3.5 h-3.5 text-dark-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                Bersihkan Sesi & Mulai Ulang
              </button>
            </div>
          </div>
        </template>
      </div>
    </div>

    <!-- Recent Activity -->
    <div class="lg:col-span-2 glass-card rounded-2xl p-6">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-sm font-semibold text-white flex items-center gap-2">
          <svg class="w-4 h-4 text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
          Aktivitas Terbaru
        </h3>
        <a href="/logs" class="text-xs text-brand-400 hover:text-brand-300 transition-colors font-medium">Lihat Semua →</a>
      </div>

      <% if (recentLogs.length === 0) { %>
        <div class="text-center py-10">
          <svg class="w-12 h-12 text-dark-600 mx-auto mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/></svg>
          <p class="text-sm text-dark-500">Belum ada aktivitas</p>
        </div>
      <% } else { %>
        <div class="space-y-2 max-h-80 overflow-y-auto">
          <% recentLogs.forEach(log => { %>
            <div class="flex items-center gap-3 p-3 rounded-xl hover:bg-dark-800/50 transition-colors group">
              <div class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0
                <%= log.direction === 'incoming' ? 'bg-blue-500/10' : log.direction === 'scheduled' ? 'bg-amber-500/10' : log.direction === 'gateway' ? 'bg-purple-500/10' : 'bg-brand-500/10' %>">
                <% if (log.direction === 'incoming') { %>
                  <svg class="w-4 h-4 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
                <% } else if (log.direction === 'scheduled') { %>
                  <svg class="w-4 h-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3"/></svg>
                <% } else { %>
                  <svg class="w-4 h-4 text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"/></svg>
                <% } %>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-sm text-dark-200 truncate">
                  <span class="font-medium text-dark-100"><%= log.commandTrigger || log.direction %></span>
                  <% if (log.groupName) { %><span class="text-dark-500"> → <%= log.groupName %></span><% } %>
                </p>
                <p class="text-xs text-dark-500 mt-0.5"><%= new Date(log.createdAt).toLocaleString('id-ID', { timeZone: 'Asia/Jakarta' }) %></p>
              </div>
              <span class="px-2 py-0.5 rounded-md text-[10px] font-semibold uppercase
                <%= log.status === 'success' ? 'bg-emerald-500/10 text-emerald-400' : 'bg-red-500/10 text-red-400' %>">
                <%= log.status %>
              </span>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Quick Links -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    <a href="/apps/create" class="glass-card rounded-2xl p-5 hover:border-brand-500/30 transition-all group text-center">
      <div class="w-12 h-12 rounded-xl bg-brand-500/10 flex items-center justify-center mx-auto mb-3 group-hover:scale-110 transition-transform">
        <svg class="w-6 h-6 text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4v16m8-8H4"/></svg>
      </div>
      <p class="text-sm font-medium text-white">Tambah Aplikasi</p>
      <p class="text-xs text-dark-400 mt-1">Daftarkan aplikasi baru</p>
    </a>
    <a href="/commands/create" class="glass-card rounded-2xl p-5 hover:border-brand-500/30 transition-all group text-center">
      <div class="w-12 h-12 rounded-xl bg-purple-500/10 flex items-center justify-center mx-auto mb-3 group-hover:scale-110 transition-transform">
        <svg class="w-6 h-6 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
      </div>
      <p class="text-sm font-medium text-white">Buat Perintah</p>
      <p class="text-xs text-dark-400 mt-1">Definisikan perintah bot baru</p>
    </a>
    <a href="/schedules/create" class="glass-card rounded-2xl p-5 hover:border-brand-500/30 transition-all group text-center">
      <div class="w-12 h-12 rounded-xl bg-amber-500/10 flex items-center justify-center mx-auto mb-3 group-hover:scale-110 transition-transform">
        <svg class="w-6 h-6 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      </div>

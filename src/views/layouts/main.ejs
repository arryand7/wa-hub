<!DOCTYPE html>
<html lang="id" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — WA Hub Sabira</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#eef9f3', 100: '#d5f1e2', 200: '#aee3c8', 300: '#7acda8',
              400: '#47b584', 500: '#25a06e', 600: '#1a7d55', 700: '#166545',
              800: '#145039', 900: '#124230', 950: '#09251b',
            },
            dark: {
              50: '#f6f6f7', 100: '#e2e3e5', 200: '#c4c6ca', 300: '#9fa2a8',
              400: '#7b7f87', 500: '#60646c', 600: '#4c4f56', 700: '#3e4047',
              800: '#2d2f34', 900: '#1e1f23', 950: '#121316',
            }
          }
        }
      }
    }
  </script>
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  <script src="/socket.io/socket.io.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { font-family: 'Inter', system-ui, sans-serif; }
    body { background: #0f1117; color: #e2e3e5; }

    /* Custom scrollbar */
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: #1e1f23; }
    ::-webkit-scrollbar-thumb { background: #3e4047; border-radius: 3px; }
    ::-webkit-scrollbar-thumb:hover { background: #60646c; }

    /* Glassmorphism card */
    .glass-card {
      background: rgba(30, 31, 35, 0.7);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.06);
    }

    /* Sidebar hover */
    .sidebar-link {
      transition: all 0.2s ease;
    }
    .sidebar-link:hover, .sidebar-link.active {
      background: rgba(37, 160, 110, 0.12);
      color: #25a06e;
      border-right: 3px solid #25a06e;
    }

    /* Gradient text */
    .gradient-text {
      background: linear-gradient(135deg, #25a06e, #47b584);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    /* Pulse dot */
    .pulse-dot {
      animation: pulse 2s infinite;
    }
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.4; }
    }

    /* Subtle glow */
    .glow-green { box-shadow: 0 0 20px rgba(37, 160, 110, 0.15); }

    /* Fade in */
    .fade-in { animation: fadeIn 0.3s ease-out; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

    /* Table rows */
    .table-row { transition: background 0.15s ease; }
    .table-row:hover { background: rgba(255, 255, 255, 0.03); }
  </style>
</head>
<body class="h-full">
  <div x-data="{ sidebarOpen: true, mobileOpen: false }" class="flex h-full">

    <!-- ─── Sidebar ────────────────────────────────────────── -->
    <aside :class="sidebarOpen ? 'w-64' : 'w-20'"
           class="hidden lg:flex flex-col fixed inset-y-0 left-0 z-30 transition-all duration-300 border-r border-dark-700"
           style="background: linear-gradient(180deg, #151619 0%, #121316 100%);">

      <!-- Logo -->
      <div class="flex items-center gap-3 px-5 py-5 border-b border-dark-700">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-500 to-brand-700 flex items-center justify-center flex-shrink-0 glow-green">
          <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
          </svg>
        </div>
        <div x-show="sidebarOpen" x-transition class="overflow-hidden">
          <h1 class="text-sm font-bold gradient-text tracking-tight">WA Hub</h1>
          <p class="text-[10px] text-dark-400 font-medium">SABIRA</p>
        </div>
      </div>

      <!-- Navigation -->
      <nav class="flex-1 py-4 space-y-1 overflow-y-auto">
        <a href="/" class="sidebar-link flex items-center gap-3 px-5 py-2.5 text-sm font-medium text-dark-300 <%= currentPage === 'dashboard' ? 'active' : '' %>">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
          <span x-show="sidebarOpen">Dashboard</span>
        </a>

        <div x-show="sidebarOpen" class="px-5 pt-4 pb-1"><p class="text-[10px] font-semibold text-dark-500 uppercase tracking-wider">Manajemen</p></div>

        <a href="/apps" class="sidebar-link flex items-center gap-3 px-5 py-2.5 text-sm font-medium text-dark-300 <%= currentPage === 'apps' ? 'active' : '' %>">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
          <span x-show="sidebarOpen">Aplikasi</span>
        </a>
        <a href="/groups" class="sidebar-link flex items-center gap-3 px-5 py-2.5 text-sm font-medium text-dark-300 <%= currentPage === 'groups' ? 'active' : '' %>">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          <span x-show="sidebarOpen">Grup WA</span>
        </a>
        <a href="/commands" class="sidebar-link flex items-center gap-3 px-5 py-2.5 text-sm font-medium text-dark-300 <%= currentPage === 'commands' ? 'active' : '' %>">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
          <span x-show="sidebarOpen">Perintah Bot</span>
        </a>
        <a href="/schedules" class="sidebar-link flex items-center gap-3 px-5 py-2.5 text-sm font-medium text-dark-300 <%= currentPage === 'schedules' ? 'active' : '' %>">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span x-show="sidebarOpen">Jadwal</span>
        </a>

        <div x-show="sidebarOpen" class="px-5 pt-4 pb-1"><p class="text-[10px] font-semibold text-dark-500 uppercase tracking-wider">Monitoring</p></div>

        <a href="/logs" class="sidebar-link flex items-center gap-3 px-5 py-2.5 text-sm font-medium text-dark-300 <%= currentPage === 'logs' ? 'active' : '' %>">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          <span x-show="sidebarOpen">Log Pesan</span>
        </a>
      </nav>

      <!-- Toggle sidebar -->
      <button @click="sidebarOpen = !sidebarOpen"
              class="flex items-center justify-center py-3 border-t border-dark-700 text-dark-400 hover:text-brand-400 transition-colors">
        <svg x-show="sidebarOpen" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 19l-7-7 7-7m8 14l-7-7 7-7"/></svg>
        <svg x-show="!sidebarOpen" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 5l7 7-7 7M5 5l7 7-7 7"/></svg>
      </button>
    </aside>

    <!-- ─── Mobile Sidebar ─────────────────────────────────── -->
    <div x-show="mobileOpen" x-transition:enter="transition ease-out duration-200"
         x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
         x-transition:leave="transition ease-in duration-150"
         x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0"
         class="fixed inset-0 z-40 bg-black/60 lg:hidden" @click="mobileOpen = false"></div>

    <aside x-show="mobileOpen" x-transition:enter="transition ease-out duration-200"
           x-transition:enter-start="-translate-x-full" x-transition:enter-end="translate-x-0"
           x-transition:leave="transition ease-in duration-150"
           x-transition:leave-start="translate-x-0" x-transition:leave-end="-translate-x-full"
           class="fixed inset-y-0 left-0 z-50 w-64 border-r border-dark-700 lg:hidden"
           style="background: linear-gradient(180deg, #151619 0%, #121316 100%);">
      <div class="flex items-center justify-between px-5 py-5 border-b border-dark-700">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-500 to-brand-700 flex items-center justify-center glow-green">
            <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
          </div>
          <div><h1 class="text-sm font-bold gradient-text">WA Hub</h1><p class="text-[10px] text-dark-400 font-medium">SABIRA</p></div>
        </div>
        <button @click="mobileOpen = false" class="text-dark-400 hover:text-white">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
      <nav class="flex-1 py-4 space-y-1 overflow-y-auto">
        <a href="/" class="sidebar-link flex items-center gap-3 px-5 py-2.5 text-sm font-medium text-dark-300 <%= currentPage === 'dashboard' ? 'active' : '' %>">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
          <span>Dashboard</span>
        </a>
        <a href="/apps" class="sidebar-link flex items-center gap-3 px-5 py-2.5 text-sm font-medium text-dark-300 <%= currentPage === 'apps' ? 'active' : '' %>"><svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg><span>Aplikasi</span></a>
        <a href="/groups" class="sidebar-link flex items-center gap-3 px-5 py-2.5 text-sm font-medium text-dark-300 <%= currentPage === 'groups' ? 'active' : '' %>"><svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg><span>Grup WA</span></a>
        <a href="/commands" class="sidebar-link flex items-center gap-3 px-5 py-2.5 text-sm font-medium text-dark-300 <%= currentPage === 'commands' ? 'active' : '' %>"><svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg><span>Perintah Bot</span></a>
        <a href="/schedules" class="sidebar-link flex items-center gap-3 px-5 py-2.5 text-sm font-medium text-dark-300 <%= currentPage === 'schedules' ? 'active' : '' %>"><svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg><span>Jadwal</span></a>
        <a href="/logs" class="sidebar-link flex items-center gap-3 px-5 py-2.5 text-sm font-medium text-dark-300 <%= currentPage === 'logs' ? 'active' : '' %>"><svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg><span>Log Pesan</span></a>
      </nav>
    </aside>

    <!-- ─── Main Content ───────────────────────────────────── -->
    <div :class="sidebarOpen ? 'lg:ml-64' : 'lg:ml-20'" class="flex-1 flex flex-col min-h-full transition-all duration-300">

      <!-- Top Bar -->
      <header class="sticky top-0 z-20 flex items-center justify-between px-4 sm:px-6 py-3 border-b border-dark-700"
              style="background: rgba(15, 17, 23, 0.85); backdrop-filter: blur(12px);">
        <div class="flex items-center gap-3">
          <button @click="mobileOpen = true" class="lg:hidden text-dark-400 hover:text-white">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
          </button>
          <h2 class="text-lg font-semibold text-dark-100"><%= title %></h2>
        </div>
        <div class="flex items-center gap-4">
          <!-- WA Status indicator -->
          <div x-data="{ status: '<%= typeof waStatus !== 'undefined' ? waStatus : 'unknown' %>' }"
               x-init="
                 const socket = io();
                 socket.on('wa:status', (d) => { status = d.status; });
               "
               class="flex items-center gap-2 text-xs font-medium">
            <span class="w-2 h-2 rounded-full"
                  :class="status === 'connected' ? 'bg-emerald-400 pulse-dot' : status === 'connecting' ? 'bg-yellow-400 pulse-dot' : 'bg-red-400'"></span>
            <span class="hidden sm:inline text-dark-400"
                  x-text="status === 'connected' ? 'WA Terhubung' : status === 'connecting' ? 'Memindai QR...' : 'WA Terputus'"></span>
          </div>

          <!-- User -->
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-brand-600 to-brand-800 flex items-center justify-center text-xs font-bold text-white">
              <%= admin ? admin.displayName.charAt(0).toUpperCase() : 'A' %>
            </div>
            <form action="/auth/logout" method="POST" class="hidden sm:block">
              <button type="submit" class="text-xs text-dark-400 hover:text-red-400 transition-colors font-medium">Logout</button>
            </form>
          </div>
        </div>
      </header>

      <!-- Flash Messages -->
      <% if (flash_success && flash_success.length > 0) { %>
        <div class="mx-4 sm:mx-6 mt-4 fade-in">
          <div class="flex items-center gap-3 px-4 py-3 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-300 text-sm">
            <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span><%= flash_success[0] %></span>
          </div>
        </div>
      <% } %>
      <% if (flash_error && flash_error.length > 0) { %>
        <div class="mx-4 sm:mx-6 mt-4 fade-in">
          <div class="flex items-center gap-3 px-4 py-3 rounded-xl bg-red-500/10 border border-red-500/20 text-red-300 text-sm">
            <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span><%= flash_error[0] %></span>
          </div>
        </div>
      <% } %>

      <!-- Page Content -->
      <main class="flex-1 p-4 sm:p-6">
        <%- body %>
      </main>

      <!-- Footer -->
      <footer class="px-6 py-3 border-t border-dark-700 text-center text-xs text-dark-500">
        WA Hub Sabira &copy; <%= new Date().getFullYear() %> — Central WhatsApp Bot Hub
      </footer>
    </div>
  </div>
</body>
</html>

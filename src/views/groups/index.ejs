<!-- Groups List -->
<div class="space-y-6 fade-in">
  <div class="flex items-center justify-between">
    <div>
      <h3 class="text-lg font-semibold text-white">Grup WhatsApp</h3>
      <p class="text-sm text-dark-400 mt-0.5">Daftar grup WA yang disinkronkan dari perangkat</p>
    </div>
    <form action="/groups/sync" method="POST">
      <button type="submit" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-gradient-to-r from-brand-600 to-brand-500 text-white text-sm font-medium hover:from-brand-500 hover:to-brand-400 transition-all shadow-lg shadow-brand-500/20">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
        Sync Daftar Grup
      </button>
    </form>
  </div>

  <% if (groups.length === 0) { %>
    <div class="glass-card rounded-2xl p-12 text-center">
      <svg class="w-16 h-16 text-dark-600 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
      <p class="text-dark-400 font-medium">Belum ada grup</p>
      <p class="text-sm text-dark-500 mt-1">Pastikan WA terhubung, lalu klik "Sync Daftar Grup"</p>
    </div>
  <% } else { %>
    <div class="glass-card rounded-2xl overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-dark-700">
              <th class="text-left px-5 py-3 text-xs font-semibold text-dark-400 uppercase tracking-wider">#</th>
              <th class="text-left px-5 py-3 text-xs font-semibold text-dark-400 uppercase tracking-wider">Nama Grup</th>
              <th class="text-left px-5 py-3 text-xs font-semibold text-dark-400 uppercase tracking-wider">JID</th>
              <th class="text-left px-5 py-3 text-xs font-semibold text-dark-400 uppercase tracking-wider">Terakhir Sync</th>
              <th class="text-right px-5 py-3 text-xs font-semibold text-dark-400 uppercase tracking-wider">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-dark-800">
            <% groups.forEach((group, idx) => { %>
              <tr class="table-row">
                <td class="px-5 py-3 text-dark-400"><%= idx + 1 %></td>
                <td class="px-5 py-3">
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg bg-brand-500/10 flex items-center justify-center flex-shrink-0">
                      <svg class="w-4 h-4 text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7"/></svg>
                    </div>
                    <span class="font-medium text-white"><%= group.name %></span>
                  </div>
                </td>
                <td class="px-5 py-3 font-mono text-xs text-dark-400"><%= group.jid %></td>
                <td class="px-5 py-3 text-dark-400 text-xs"><%= new Date(group.syncedAt).toLocaleString('id-ID', { timeZone: 'Asia/Jakarta' }) %></td>
                <td class="px-5 py-3 text-right">
                  <form action="/groups/<%= group.id %>/delete" method="POST" class="inline" onsubmit="return confirm('Hapus grup ini dari daftar?')">
                    <button type="submit" class="p-1.5 rounded-lg text-dark-500 hover:text-red-400 hover:bg-red-500/10 transition-colors">
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
    <p class="text-xs text-dark-500 text-center">Total: <%= groups.length %> grup</p>
  <% } %>
</div>

<!-- Commands List -->
<div class="space-y-6 fade-in">
  <div class="flex items-center justify-between">
    <div>
      <h3 class="text-lg font-semibold text-white">Perintah Bot</h3>
      <p class="text-sm text-dark-400 mt-0.5">Kelola perintah yang bisa digunakan di grup WhatsApp</p>
    </div>
    <a href="/commands/create" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-gradient-to-r from-brand-600 to-brand-500 text-white text-sm font-medium hover:from-brand-500 hover:to-brand-400 transition-all shadow-lg shadow-brand-500/20">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      Tambah Perintah
    </a>
  </div>

  <% if (commands.length === 0) { %>
    <div class="glass-card rounded-2xl p-12 text-center">
      <svg class="w-16 h-16 text-dark-600 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
      <p class="text-dark-400 font-medium">Belum ada perintah bot</p>
      <p class="text-sm text-dark-500 mt-1">Buat perintah pertama untuk memulai</p>
    </div>
  <% } else { %>
    <div class="grid gap-4">
      <% commands.forEach(cmd => { %>
        <div class="glass-card rounded-2xl p-5 hover:border-brand-500/20 transition-all">
          <div class="flex items-start justify-between gap-4">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <code class="px-2.5 py-1 rounded-lg bg-purple-500/10 text-purple-300 text-sm font-semibold font-mono"><%= cmd.triggerCommand %></code>
                <span class="px-2 py-0.5 rounded-md text-[10px] font-semibold uppercase
                  <%= cmd.isActive ? 'bg-emerald-500/10 text-emerald-400' : 'bg-dark-700 text-dark-400' %>">
                  <%= cmd.isActive ? 'Aktif' : 'Nonaktif' %>
                </span>
                <% if (cmd.allGroups) { %>
                  <span class="px-2 py-0.5 rounded-md bg-blue-500/10 text-blue-400 text-[10px] font-semibold">Semua Grup</span>
                <% } else { %>
                  <span class="px-2 py-0.5 rounded-md bg-amber-500/10 text-amber-400 text-[10px] font-semibold">
                    <%= cmd.commandGroups.length %> Grup
                  </span>
                <% } %>
              </div>
              <p class="text-sm text-dark-300 mt-2"><%= cmd.description || 'Tidak ada deskripsi' %></p>
              <div class="flex items-center gap-3 mt-2 text-xs text-dark-500">
                <span class="flex items-center gap-1">
                  <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
                  <%= cmd.app.name %>
                </span>
                <span class="flex items-center gap-1">
                  <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                  <%= cmd.actionId %>
                </span>
              </div>
            </div>
            <div class="flex items-center gap-2 flex-shrink-0">
              <a href="/commands/<%= cmd.id %>/edit" class="p-2 rounded-lg bg-dark-700 text-dark-300 hover:bg-dark-600 hover:text-white transition-colors">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
              </a>
              <form action="/commands/<%= cmd.id %>/delete" method="POST" onsubmit="return confirm('Hapus perintah ini?')">
                <button type="submit" class="p-2 rounded-lg bg-red-500/10 text-red-400 hover:bg-red-500/20 transition-colors">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                </button>
              </form>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

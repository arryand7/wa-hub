<!-- Apps List -->
<div class="space-y-6 fade-in">
  <div class="flex items-center justify-between">
    <div>
      <h3 class="text-lg font-semibold text-white">Daftar Aplikasi</h3>
      <p class="text-sm text-dark-400 mt-0.5">Kelola aplikasi eksternal yang terhubung ke Bot Hub</p>
    </div>
    <a href="/apps/create" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-gradient-to-r from-brand-600 to-brand-500 text-white text-sm font-medium hover:from-brand-500 hover:to-brand-400 transition-all shadow-lg shadow-brand-500/20">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      Tambah Aplikasi
    </a>
  </div>

  <% if (apps.length === 0) { %>
    <div class="glass-card rounded-2xl p-12 text-center">
      <svg class="w-16 h-16 text-dark-600 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
      <p class="text-dark-400 font-medium">Belum ada aplikasi terdaftar</p>
      <p class="text-sm text-dark-500 mt-1">Klik tombol "Tambah Aplikasi" untuk memulai</p>
    </div>
  <% } else { %>
    <div class="grid gap-4">
      <% apps.forEach(app => { %>
        <div class="glass-card rounded-2xl p-5 hover:border-brand-500/20 transition-all">
          <div class="flex items-start justify-between gap-4">
            <div class="flex items-start gap-4 flex-1 min-w-0">
              <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-blue-500/20 to-purple-500/20 flex items-center justify-center flex-shrink-0">
                <span class="text-lg font-bold text-blue-400"><%= app.name.charAt(0).toUpperCase() %></span>
              </div>
              <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2 flex-wrap">
                  <h4 class="text-sm font-semibold text-white"><%= app.name %></h4>
                  <span class="px-2 py-0.5 rounded-md text-[10px] font-semibold uppercase
                    <%= app.isActive ? 'bg-emerald-500/10 text-emerald-400' : 'bg-dark-700 text-dark-400' %>">
                    <%= app.isActive ? 'Aktif' : 'Nonaktif' %>
                  </span>
                </div>
                <p class="text-xs text-dark-400 mt-1 truncate">
                  <span class="px-1.5 py-0.5 rounded bg-dark-800 text-dark-300 font-mono"><%= app.slug %></span>
                  <span class="ml-2"><%= app.baseUrl %></span>
                </p>
                <% if (app.lastSyncedAt) { %>
                  <p class="text-xs text-dark-500 mt-1.5">
                    🔄 Manifest disync: <%= new Date(app.lastSyncedAt).toLocaleString('id-ID', { timeZone: 'Asia/Jakarta' }) %>
                  </p>
                <% } %>
                <% if (app.manifestJson) { %>
                  <% const manifest = JSON.parse(app.manifestJson); %>
                  <% const actions = Array.isArray(manifest.actions)
                    ? manifest.actions.map((action, index) => [index, action])
                    : Object.entries(manifest.actions || {}); %>
                  <% if (actions.length) { %>
                    <div class="flex flex-wrap gap-1.5 mt-2">
                      <% actions.forEach(([actionId, action]) => { %>
                        <span class="px-2 py-0.5 rounded-lg bg-purple-500/10 text-purple-300 text-[10px] font-medium"><%= action.label || action.name || action.id || actionId %></span>
                      <% }); %>
                    </div>
                  <% } %>
                <% } %>
              </div>
            </div>
            <div class="flex items-center gap-2 flex-shrink-0">
              <form action="/apps/<%= app.id %>/sync-manifest" method="POST">
                <button type="submit" title="Sync Manifest" class="p-2 rounded-lg bg-brand-500/10 text-brand-400 hover:bg-brand-500/20 transition-colors">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                </button>
              </form>
              <a href="/apps/<%= app.id %>/edit" title="Edit" class="p-2 rounded-lg bg-dark-700 text-dark-300 hover:bg-dark-600 hover:text-white transition-colors">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
              </a>
              <form action="/apps/<%= app.id %>/delete" method="POST" onsubmit="return confirm('Hapus aplikasi ini?')">
                <button type="submit" title="Hapus" class="p-2 rounded-lg bg-red-500/10 text-red-400 hover:bg-red-500/20 transition-colors">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                </button>
              </form>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

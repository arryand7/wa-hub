<!-- Message Logs -->
<div class="space-y-6 fade-in">
  <div class="flex items-center justify-between flex-wrap gap-4">
    <div>
      <h3 class="text-lg font-semibold text-white">Riwayat Log Pesan</h3>
      <p class="text-sm text-dark-400 mt-0.5">Total: <%= total %> log</p>
    </div>
    <div class="flex items-center gap-2">
      <form action="/logs/clear" method="POST" onsubmit="return confirm('Hapus log >30 hari?')">
        <button type="submit" class="inline-flex items-center gap-2 px-3 py-2 rounded-xl bg-dark-700 text-dark-300 text-xs font-medium hover:bg-red-500/10 hover:text-red-400 transition-all">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
          Hapus Log Lama
        </button>
      </form>
    </div>
  </div>

  <!-- Filters -->
  <div class="flex flex-wrap gap-2">
    <a href="/logs?filter=all&status=<%= statusFilter %>"
       class="px-3 py-1.5 rounded-lg text-xs font-medium transition-colors
         <%= filter === 'all' ? 'bg-brand-500/20 text-brand-300' : 'bg-dark-700 text-dark-400 hover:text-white' %>">
      Semua
    </a>
    <a href="/logs?filter=incoming&status=<%= statusFilter %>"
       class="px-3 py-1.5 rounded-lg text-xs font-medium transition-colors
         <%= filter === 'incoming' ? 'bg-blue-500/20 text-blue-300' : 'bg-dark-700 text-dark-400 hover:text-white' %>">
      📥 Masuk
    </a>
    <a href="/logs?filter=outgoing&status=<%= statusFilter %>"
       class="px-3 py-1.5 rounded-lg text-xs font-medium transition-colors
         <%= filter === 'outgoing' ? 'bg-brand-500/20 text-brand-300' : 'bg-dark-700 text-dark-400 hover:text-white' %>">
      📤 Keluar
    </a>
    <a href="/logs?filter=scheduled&status=<%= statusFilter %>"
       class="px-3 py-1.5 rounded-lg text-xs font-medium transition-colors
         <%= filter === 'scheduled' ? 'bg-amber-500/20 text-amber-300' : 'bg-dark-700 text-dark-400 hover:text-white' %>">
      ⏰ Terjadwal
    </a>
    <a href="/logs?filter=gateway&status=<%= statusFilter %>"
       class="px-3 py-1.5 rounded-lg text-xs font-medium transition-colors
         <%= filter === 'gateway' ? 'bg-purple-500/20 text-purple-300' : 'bg-dark-700 text-dark-400 hover:text-white' %>">
      🔌 Gateway
    </a>

    <div class="border-l border-dark-700 mx-2"></div>

    <a href="/logs?filter=<%= filter %>&status=all"
       class="px-3 py-1.5 rounded-lg text-xs font-medium transition-colors
         <%= statusFilter === 'all' ? 'bg-dark-600 text-white' : 'bg-dark-700 text-dark-400 hover:text-white' %>">
      Status: Semua
    </a>
    <a href="/logs?filter=<%= filter %>&status=success"
       class="px-3 py-1.5 rounded-lg text-xs font-medium transition-colors
         <%= statusFilter === 'success' ? 'bg-emerald-500/20 text-emerald-300' : 'bg-dark-700 text-dark-400 hover:text-white' %>">
      ✅ Sukses
    </a>
    <a href="/logs?filter=<%= filter %>&status=error"
       class="px-3 py-1.5 rounded-lg text-xs font-medium transition-colors
         <%= statusFilter === 'error' ? 'bg-red-500/20 text-red-300' : 'bg-dark-700 text-dark-400 hover:text-white' %>">
      ❌ Error
    </a>
  </div>

  <% if (logs.length === 0) { %>
    <div class="glass-card rounded-2xl p-12 text-center">
      <svg class="w-16 h-16 text-dark-600 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
      <p class="text-dark-400">Tidak ada log untuk filter ini</p>
    </div>
  <% } else { %>
    <div class="glass-card rounded-2xl overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-dark-700">
              <th class="text-left px-4 py-3 text-xs font-semibold text-dark-400 uppercase tracking-wider">Waktu</th>
              <th class="text-left px-4 py-3 text-xs font-semibold text-dark-400 uppercase tracking-wider">Arah</th>
              <th class="text-left px-4 py-3 text-xs font-semibold text-dark-400 uppercase tracking-wider">Perintah</th>
              <th class="text-left px-4 py-3 text-xs font-semibold text-dark-400 uppercase tracking-wider">Tujuan</th>
              <th class="text-left px-4 py-3 text-xs font-semibold text-dark-400 uppercase tracking-wider">Status</th>
              <th class="text-left px-4 py-3 text-xs font-semibold text-dark-400 uppercase tracking-wider">Detail</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-dark-800" x-data="{ expanded: null }">
            <% logs.forEach((log, idx) => { %>
              <tr class="table-row cursor-pointer" @click="expanded = expanded === <%= idx %> ? null : <%= idx %>">
                <td class="px-4 py-3 text-xs text-dark-400 whitespace-nowrap">
                  <%= new Date(log.createdAt).toLocaleString('id-ID', { timeZone: 'Asia/Jakarta', hour12: false }) %>
                </td>
                <td class="px-4 py-3">
                  <span class="px-2 py-0.5 rounded-md text-[10px] font-semibold uppercase
                    <%= log.direction === 'incoming' ? 'bg-blue-500/10 text-blue-400' :
                        log.direction === 'scheduled' ? 'bg-amber-500/10 text-amber-400' :
                        log.direction === 'gateway' ? 'bg-purple-500/10 text-purple-400' :
                        'bg-brand-500/10 text-brand-400' %>">
                    <%= log.direction %>
                  </span>
                </td>
                <td class="px-4 py-3 font-mono text-xs text-dark-200"><%= log.commandTrigger || '-' %></td>
                <td class="px-4 py-3 text-xs text-dark-400 max-w-[200px] truncate"><%= log.groupName || log.waJid || '-' %></td>
                <td class="px-4 py-3">
                  <span class="px-2 py-0.5 rounded-md text-[10px] font-semibold uppercase
                    <%= log.status === 'success' ? 'bg-emerald-500/10 text-emerald-400' : 'bg-red-500/10 text-red-400' %>">
                    <%= log.status %>
                  </span>
                </td>
                <td class="px-4 py-3 text-xs text-dark-500">
                  <svg class="w-4 h-4 transition-transform" :class="expanded === <%= idx %> ? 'rotate-180' : ''" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </td>
              </tr>
              <tr x-show="expanded === <%= idx %>" x-transition>
                <td colspan="6" class="px-4 py-3 bg-dark-900/50">
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-xs">
                    <% if (log.errorMessage) { %>
                      <div class="md:col-span-2 p-3 rounded-lg bg-red-500/5 border border-red-500/10">
                        <p class="text-red-400 font-semibold mb-1">Error:</p>
                        <p class="text-red-300 font-mono"><%= log.errorMessage %></p>
                      </div>
                    <% } %>
                    <div class="p-3 rounded-lg bg-dark-800">
                      <p class="text-dark-500 font-semibold mb-1">Request:</p>
                      <pre class="text-dark-300 font-mono text-[11px] overflow-x-auto whitespace-pre-wrap"><%= log.requestBody || '-' %></pre>
                    </div>
                    <div class="p-3 rounded-lg bg-dark-800">
                      <p class="text-dark-500 font-semibold mb-1">Response:</p>
                      <pre class="text-dark-300 font-mono text-[11px] overflow-x-auto whitespace-pre-wrap max-h-40 overflow-y-auto"><%= log.responseBody ? log.responseBody.substring(0, 500) : '-' %></pre>
                    </div>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Pagination -->
    <% if (totalPages > 1) { %>
      <div class="flex items-center justify-center gap-2">
        <% if (page > 1) { %>
          <a href="/logs?page=<%= page - 1 %>&filter=<%= filter %>&status=<%= statusFilter %>"
             class="px-3 py-1.5 rounded-lg bg-dark-700 text-dark-300 text-xs hover:bg-dark-600 transition-colors">
            ← Sebelumnya
          </a>
        <% } %>
        <span class="px-3 py-1.5 text-xs text-dark-400">Halaman <%= page %> dari <%= totalPages %></span>
        <% if (page < totalPages) { %>
          <a href="/logs?page=<%= page + 1 %>&filter=<%= filter %>&status=<%= statusFilter %>"
             class="px-3 py-1.5 rounded-lg bg-dark-700 text-dark-300 text-xs hover:bg-dark-600 transition-colors">
            Selanjutnya →
          </a>
        <% } %>
      </div>
    <% } %>
  <% } %>
</div>
